# --- Supabase (optional). Sin estas variables la app corre en modo demostración ---
# URL pública de la app (usada en enlaces mágicos y metadatos).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL del proyecto, p. ej. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon/publishable). Segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio. SOLO servidor: nunca expongas esta variable al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de Storage para fotografías de reportes.
SUPABASE_STORAGE_BUCKET=case-photos

# Directorio de datos del modo demostración (persistencia local en disco).
VOTAVIA_DATA_DIR=.data

# Correo del equipo que puede aprovisionar roles de gobierno/especialista (CSV).
VOTAVIA_GOVERNMENT_EMAILS=

# Fotografía del hero (licencia Unsplash). Déjalo vacío para usar el degradado de marca.
NEXT_PUBLIC_HERO_IMAGE_URL=
