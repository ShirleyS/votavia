# --- Supabase (optional). Sin estas variables la app corre en modo demostración ---
# URL del proyecto, p. ej. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon/publishable). Segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio. SOLO servidor: nunca expongas esta variable al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de Storage para fotografías de reportes.
SUPABASE_STORAGE_BUCKET=case-photos

# Directorio de datos del modo demostración (persistencia local en disco).
VOTAVIA_DATA_DIR=.data

# Correo del equipo que puede aprovisionar roles de gobierno/especialista (CSV).
VOTAVIA_GOVERNMENT_EMAILS=

# Fotografía del hero (licencia Unsplash). Déjalo vacío para usar el degradado de marca.
NEXT_PUBLIC_HERO_IMAGE_URL=

# --- API pública (Session 4) ---
# demo: datos ficticios locales (predeterminado). live: lee la plataforma real.
# Si VOTAVIA_INTERNAL_API_BASE_URL tiene valor, el modo live se activa automáticamente.
VOTAVIA_PUBLIC_API_MODE=demo
# Base interna de la plataforma de casos. En despliegue separado, por ejemplo:
# https://votavia.mx  (se consultan /api/cases, /api/cases/:id y /api/stats).
VOTAVIA_INTERNAL_API_BASE_URL=
# Token opcional que la API pública envía como x-votavia-internal-token.
VOTAVIA_INTERNAL_API_TOKEN=
# Feed HTTP del motor preventivo (Session 3). Debe devolver { "signals": [...] }
# con señales ya aprobadas. Sin esta variable, el endpoint responde 503 en modo live.
VOTAVIA_RISK_SIGNALS_URL=
# Token opcional para el feed preventivo (Authorization: Bearer ...).
VOTAVIA_RISK_SIGNALS_TOKEN=
# Ruta pública de un caso en la plataforma ciudadana (se concatena con case_id).
VOTAVIA_CASE_PERMALINK_PATH=/casos
# Dominio público usado para construir permalinks y ejemplos del portal.
NEXT_PUBLIC_APP_URL=

# --- Feed de registros gubernamentales importados ---
# Desactivado por omisión. Actívalo SOLO cuando exista una fuente con acceso legítimo,
# licencia redistribuible y permiso verificado. VotaVía no ofrece una API oficial de CDMX.
VOTAVIA_OFFICIAL_FEED_ENABLED=false
# Identificador de licencia de la fuente (p. ej. cc-by-4.0). Sin este valor, el feed
# queda en "awaiting_permission" y no se publica ningún registro importado.
VOTAVIA_OFFICIAL_SOURCE_LICENSE=
# Texto de atribución que se muestra junto a los registros importados.
VOTAVIA_OFFICIAL_SOURCE_ATTRIBUTION=
# Fecha ISO de la última sincronización de la fuente; alimenta la frescura publicada.
VOTAVIA_OFFICIAL_LAST_SYNCED_AT=
# Salida normalizada de la ingesta (Session 6), consumida en SOLO LECTURA.
# JSONL con un registro NormalizedOfficialRecord por línea. Nunca se escribe aquí.
VOTAVIA_OFFICIAL_RECORDS_PATH=
# Manifiesto de la corrida de ingesta (licencia del conjunto, conteos, fechas).
VOTAVIA_OFFICIAL_MANIFEST_PATH=

# --- Límites públicos ---
# Solicitudes por minuto e IP. En producción multinodo usa un limitador distribuido.
VOTAVIA_PUBLIC_RATE_LIMIT=120
