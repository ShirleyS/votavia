# Consola de gobierno VotaVía — variables del camino de producción (modo núcleo).

# Origen del núcleo de Session 1. El navegador llama /core-api/* y Next lo
# reescribe a ${VOTAVIA_CORE_ORIGIN}/api/*, reenviando la cookie de sesión.
# Sin esta variable la consola no tiene backend y muestra "núcleo no disponible";
# nunca cae a datos de muestra.
VOTAVIA_CORE_ORIGIN=http://localhost:3000

# Modo de datos. El valor por omisión es `core` (APIs reales).
# `demo` es una excepción explícita con datos ficticios en localStorage,
# sólo para revisar la interfaz sin núcleo; la consola la rotula en pantalla.
# NEXT_PUBLIC_VOTAVIA_API_MODE=core

# Ruta base que usa el navegador para el núcleo (por omisión /core-api).
# NEXT_PUBLIC_VOTAVIA_CORE_BASE_PATH=/core-api
