# --- Supabase (optional). Sin estas variables la app corre en modo demostración ---
# URL pública de la app (usada en enlaces mágicos y metadatos).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL del proyecto, p. ej. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon/publishable). Segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio. SOLO servidor: nunca expongas esta variable al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de Storage para fotografías de reportes.
SUPABASE_STORAGE_BUCKET=case-photos

# Directorio de datos del modo demostración (persistencia local en disco).
VOTAVIA_DATA_DIR=.data

# Correo del equipo que puede aprovisionar roles de gobierno/especialista (CSV).
VOTAVIA_GOVERNMENT_EMAILS=

# Fotografía del hero (licencia Unsplash). Déjalo vacío para usar el degradado de marca.
NEXT_PUBLIC_HERO_IMAGE_URL=

# --- WhatsApp Cloud API (opcional). Sin token la bandeja entra en dry-run ---
# Token de sistema de Meta con permiso whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=
# Id del número de WhatsApp Business (no el número telefónico).
WHATSAPP_PHONE_NUMBER_ID=
# Token que tú defines y pegas en Meta al suscribir el webhook.
WHATSAPP_VERIFY_TOKEN=
# App secret de Meta; obligatorio para validar X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Versión de Graph API. Súbela cuando Meta deprecie la actual.
WHATSAPP_GRAPH_VERSION=v23.0
# 1 fuerza dry-run (no envía mensajes reales), útil en desarrollo.
WHATSAPP_DRY_RUN=

# --- Transcripción de notas de voz (opcional) ---
# Cualquier endpoint compatible con POST /audio/transcriptions.
WHATSAPP_TRANSCRIBE_API_KEY=
WHATSAPP_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
WHATSAPP_TRANSCRIBE_MODEL=whisper-1
