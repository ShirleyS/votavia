# Browser collection is disabled by default. Keep this unset until the
# dashboard terms and automated-access permission have been verified.
# VOTAVIA_0311_BROWSER_APPROVED=1

# Optional: override the honest collector user agent.
# VOTAVIA_0311_USER_AGENT=VotaVia-0311-collector/0.1

# Optional: HTTP timeout in milliseconds.
# VOTAVIA_0311_HTTP_TIMEOUT_MS=60000

# Optional: data directory (defaults to ./data/official-0311).
# VOTAVIA_0311_DATA_DIR=./data/official-0311
